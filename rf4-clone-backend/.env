APP_NAME=RF4 Clone Backend
APP_ENV=local
APP_DEBUG=true

APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rf4clone
DB_USERNAME=root
DB_PASSWORD=your_db_password

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls

APP_KEY=your_random_app_key

LOG_CHANNEL=stack
SESSION_DRIVER=file
SESSION_LIFETIME=120
